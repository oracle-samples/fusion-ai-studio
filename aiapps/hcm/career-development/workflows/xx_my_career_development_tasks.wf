          "inputs": []
        },
        {
          "id": "1784100000003",
          "code": "PROCESS_CAREER_DEVELOPMENT_TASKS",
          "type": "CODE",
          "metadata": {
            "name": "Process Career Development Tasks",
            "returnType": "object",
            "sourceCode": "function toObject(value) {\n  if (value == null || value === \"\") return {};\n  if (typeof value === \"string\") {\n    try {\n      return JSON.parse(value);\n    } catch (error) {\n      return {};\n    }\n  }\n  return value;\n}\n\nfunction clean(value) {\n  return value === undefined || value === null ? \"\" : String(value).trim();\n}\n\nfunction sanitizeDisplayText(value) {\n  return clean(value)\n    .replace(/[\\u0000-\\u001F\\u007F]/g, \"\")\n    .replace(/[\\u202A-\\u202E\\u2066-\\u2069]/g, \"\")\n    .replace(/\\s+/g, \" \")\n    .trim();\n}\n\nfunction toDateOnly(value) {\n  if (!value) return null;\n\n  if (value instanceof Date) {\n    const dateFromObject = new Date(value.getFullYear(), value.getMonth(), value.getDate());\n    return Number.isNaN(dateFromObject.getTime()) ? null : dateFromObject;\n  }\n\n  const stringValue = String(value).trim();\n  const dateOnlyMatch = stringValue.match(/^(\\d{4})-(\\d{2})-(\\d{2})/);\n\n  if (dateOnlyMatch) {\n    const year = Number(dateOnlyMatch[1]);\n    const month = Number(dateOnlyMatch[2]) - 1;\n    const day = Number(dateOnlyMatch[3]);\n    const dateFromParts = new Date(year, month, day);\n    return Number.isNaN(dateFromParts.getTime()) ? null : dateFromParts;\n  }\n\n  const date = new Date(value);\n  if (Number.isNaN(date.getTime())) return null;\n  return new Date(date.getFullYear(), date.getMonth(), date.getDate());\n}\n\nfunction pluralizeDays(days) {\n  return days === 1 ? \"day\" : \"days\";\n}\n\n\nconst input = toObject($context.$nodes.FETCH_CAREER_DEVELOPMENT_TASKS.$output);\nconst tasks = Array.isArray(input.items) ? input.items : [];\nconst today = toDateOnly($context.$system.$currentDate) || toDateOnly(new Date());\nconst millisecondsPerDay = 24 * 60 * 60 * 1000;\n\nconst items = tasks.slice(0, 5).map(function (task) {\n  const targetDate = toDateOnly(task.TargetEndDate);\n  const dayDifference = targetDate\n    ? Math.floor((targetDate.getTime() - today.getTime()) / millisecondsPerDay)\n    : null;\n\n  let badgeText = \"\";\n  let priority = \"\";\n\n  if (dayDifference !== null && dayDifference < 0) {\n    const overdueDays = Math.abs(dayDifference);\n    badgeText = \"Overdue by \" + overdueDays + \" \" + pluralizeDays(overdueDays);\n    priority = \"alert\";\n  } else if (dayDifference !== null) {\n    badgeText = \"Due in \" + dayDifference + \" \" + pluralizeDays(dayDifference);\n    priority = \"info\";\n  }\n\n  const item = {\n    title: sanitizeDisplayText(task.Name),\n    subtitle: sanitizeDisplayText(task.JourneyName),\n    summary: sanitizeDisplayText(\"For \" + clean(task.JourneyPersonName))\n  };\n\n  if (badgeText) {\n    item.badgeText = badgeText;\n    item.priority = priority;\n  }\n  if(task.RequiredFlag){\n    item.status = \"Required\";\n  }\n\n  return item;\n});\n\nreturn {\n  items: items,\n  count: items.length\n};",
            "description": "Processes and prepares career development tasks for display."
          },
          "diagram": {
            "x": 5000,
            "y": 5428
          },
          "outcomes": {
            "success": "1784100000004"
          },
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
        {
          "id": "1784100000004",
          "code": "DISPLAY_CAREER_DEVELOPMENT_TASKS",
          "type": "LLM",
          "metadata": {
            "name": "Display Career Development Tasks",
            "description": "Displays career development tasks."
          },
          "diagram": {
