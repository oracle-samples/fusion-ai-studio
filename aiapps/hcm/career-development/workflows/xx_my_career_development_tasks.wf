        {
          "id": "1784100000001",
          "code": "FETCH_CAREER_DEVELOPMENT_TASKS",
          "type": "BO_FUNCTION",
          "metadata": {
            "name": "Fetch Career Development Tasks",
            "businessObjectCode": "ORA_HCM_JOURNEYS_XX_CAREERDEVELOPMENTTASKS",
            "functionName": "getCareerDevelopmentTasks",
            "description": "Retrieves career development tasks assigned to the logged-in person."
          },
          "diagram": {
            "x": 5009,
            "y": 5206
          },
          "outcomes": {
            "success": "1784100000003"
