          "code": "RETURN_STRUCTURED_CHATBOT_DATA",
          "id": "1775812343034",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Prepare Task Data",
            "returnType": "object",
            "sourceCode": "let result = {};\ntry {\n  const getValue = (attribute) => {\n    return (attribute == null || attribute === '' || (typeof attribute === 'string' && attribute.trim() === '') || attribute === '<provide a value>') ? '' : attribute;\n  };\n\n// Declare once so they’re in scope for the result object below\nlet taskName = \"\";\nlet taskURL = \"\";\nlet instructions = \"\";\nlet startDate = \"\";\nlet endDate = \"\";\nlet description = \"\";\n\n\nif($context.$nodes.CHECK_INPUT_TRIGGERS_VALIDITY.$output.result)\n{\ntaskName = getValue($context.$triggers.REST.$input.name);\n  taskURL = getValue($context.$triggers.REST.$input.taskURL);\n  instructions = getValue($context.$triggers.REST.$input.instructions);\n  startDate = getValue($context.$triggers.REST.$input.startDate);\n//If startDate is missing, default to the workflow system current date.\n  if (startDate === '') startDate = $context.$system.$currentDate || '';\n  endDate = getValue($context.$triggers.REST.$input.endDate);\n//If endDate is missing, default to seven calendar days after the system current date.\n  if (endDate === '') {\n    let tempDate = new Date(($context.$system?.$currentDate || '') + \"T00:00:00\");\n    tempDate.setDate(tempDate.getDate() + 7);\n    endDate = tempDate.toISOString().split('T')[0];\n  }\n  description = getValue($context.$triggers.REST.$input.description);\n\n}\nelse\n{\n taskName = getValue($context.$nodes.RETURN_STRUCTURED_CHATBOT_DATA.$output.result.name);\n  taskURL = getValue($context.$nodes.RETURN_STRUCTURED_CHATBOT_DATA.$output.result.taskURL);\n  instructions = getValue($context.$nodes.RETURN_STRUCTURED_CHATBOT_DATA.$output.result.instructions);\n  startDate = getValue($context.$nodes.RETURN_STRUCTURED_CHATBOT_DATA.$output.result.startDate);\n//If startDate is missing, default to the workflow system current date.\n  if (startDate === '') startDate = $context.$system.$currentDate || '';\n  endDate = getValue($context.$nodes.RETURN_STRUCTURED_CHATBOT_DATA.$output.result.endDate);\n//If endDate is missing, default to seven calendar days after the system current date.\n  if (endDate === '') {\n    let tempDate = new Date(($context.$system?.$currentDate || '') + \"T00:00:00\");\n    tempDate.setDate(tempDate.getDate() + 7);\n    endDate = tempDate.toISOString().split('T')[0];\n  }\n  description = getValue($context.$nodes.RETURN_STRUCTURED_CHATBOT_DATA.$output.result.description);\n}\n  \n  // Determine type field based on taskURL presence\n  let type = 'ORA_CHK_MANUAL';\n  if (taskURL !== '') {\n    type = 'ORA_CHK_EXTERNAL_URL';\n  }\n\n  \n  result = {\n    taskName: taskName,\n    startDate: startDate,\n    endDate: endDate,\n    description: description,\n    taskURL: taskURL,\n    instructions: instructions,\n    type: type\n  };\n} catch (error) {\n  // Return safe default object on error\n  result = {\n    taskName: '',\n    startDate: '',\n    endDate: '',\n    description: '',\n    taskURL: '',\n    instructions: '',\n    type: 'ORA_CHK_MANUAL'\n  };\n}\n\nreturn result;"
          },
          "outcomes": {
            "success": "1775804969296"
          },
          "diagram": {
            "x": 5978,
            "y": 6316
          },
          "code": "PREPARE_TASK_DATA",
          "id": "1775555409772",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE"
        },
        {
          "metadata": {
            "name": "Validate Required Fields and Date Logic",
            "returnType": "object",
            "sourceCode": "let result = { status: false, errormessage: \"\" };\n\nconst isEmpty = (value) => {\n  return (\n    value == null ||\n    value === \"\" ||\n    (typeof value === \"string\" && value.trim() === \"\") ||\n    value === \"<provide a value>\"\n  );\n};\n\nconst isIsoDate = (value) => {\n  return typeof value === \"string\" &&\n    /^\\d{4}-\\d{2}-\\d{2}$/.test(value) &&\n    !Number.isNaN(Date.parse(value + \"T00:00:00Z\"));\n};\n\ntry {\n  const inputResult =\n    $context.$nodes?.PREPARE_TASK_DATA?.$output?.result || {};\n\n  const taskName = inputResult.taskName;\n  const startDate = inputResult.startDate;\n  const endDate = inputResult.endDate;\n\n  const errors = [];\n\n  if (isEmpty(taskName)) {\n    errors.push(\"Name not provided\");\n  }\n\n  if (!isIsoDate(startDate)) {\n    errors.push(\"Start date must be in YYYY-MM-DD format\");\n  }\n\n  if (!isIsoDate(endDate)) {\n    errors.push(\"End date must be in YYYY-MM-DD format\");\n  }\n\n  if (isIsoDate(startDate) && isIsoDate(endDate)) {\n    const start = new Date(startDate + \"T00:00:00Z\");\n    const end = new Date(endDate + \"T00:00:00Z\");\n\n    if (start > end) {\n      errors.push(\"Start date is after end date\");\n    }\n  }\n\n  result = {\n    status: errors.length === 0,\n    errormessage: errors.join(\"; \")\n  };\n} catch (error) {\n  result = {\n    status: false,\n    errormessage: \"An error occurred during validation.\"\n  };\n}\n\nreturn result;"
          },
          "outcomes": {
            "success": "1775559342479"
          },
