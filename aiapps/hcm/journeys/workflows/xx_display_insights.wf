                  "inputs": [
                    {
                      "id": "1780574799553_pWorkerJourneyId",
                      "name": "pWorkerJourneyId",
                      "type": "integer",
                      "value": "{{null}}"
                    },
                    {
                      "id": "1780574799553_pWorkerJourneyTaskId",
                      "name": "pWorkerJourneyTaskId",
                      "type": "integer",
                      "value": "{{$context.$nodes.GENERATE_DEEPLINKS.$currentItem?.WorkerJourneyTaskId}}"
                    }
                  ]
                },
                {
                  "id": "1784118840384",
                  "code": "APPEND_TASK_DEEPLINK",
                  "type": "CODE",
                  "metadata": {
                    "name": "Append task deeplink",
                    "sourceCode": "let taskData = $context.$variables.tasksData;\nlet currItem = $context.$nodes.GENERATE_DEEPLINKS.$currentItem;\nlet link = $context.$nodes.GENERATE_DEEPLINKS.GENERATE_TASK_DEEPLINK.$output;\n\n// Ensure taskData is an array before adding a new entry.\nif (!Array.isArray(taskData)) {\n  taskData = [];\n}\n\n// Create a new object so the current loop item is not mutated unexpectedly.\nlet updatedCurrItem = {\n  ...currItem,\n  url: link\n};\n\ntaskData.push(updatedCurrItem);\n\nreturn taskData;",
                    "returnType": "object"
                  },
                  "diagram": {
                    "x": 5150,
                    "y": 6335
                  },
                  "outcomes": {
                    "success": "1784118840385"
                  },
                  "inputs": [],
                  "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
                },
