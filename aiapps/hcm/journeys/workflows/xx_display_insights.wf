          "metadata": {
            "name": "Fetch Insights",
            "businessObjectCode": "ORA_HCM_JOURNEYS_XX_JOURNEYTASKCOLLECTIONS",
            "functionName": "get_tasks"
          },
          "diagram": {
            "x": 5150,
