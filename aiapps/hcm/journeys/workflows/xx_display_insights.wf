        },
        {
          "id": "1784118586320",
          "code": "SET_COLLECTIONLIST",
          "type": "CODE",
          "metadata": {
            "name": "Set CollectionList",
            "returnType": "array",
            "sourceCode": "const items = $context.$nodes.FETCH_INSIGHTS.$output.items || [];\nconst todayStr = new Date().toISOString().split(\"T\")[0];\n\nitems.forEach(item => {\n  const targetStr = item.TargetEndDate;\n\n  if (!targetStr) {\n    item.dueDays = \"\";\n    item.dueType = \"\";\n  } else {\n    const today = new Date(todayStr);\n    const targetDate = new Date(targetStr);\n\n    const diffTime = targetDate - today;\n    const dueDays = Math.floor(diffTime / (1000 * 60 * 60 * 24));\n\n    item.dueDays = dueDays;\n\n    if (dueDays < 0) {\n      item.dueType = \"OverDue\";\n    } else {\n      item.dueType = \"Due\";\n    }\n  }\n});\n\nreturn items;"
          },
          "diagram": {
            "x": 5150,
            "y": 5650
          },
          "outcomes": {
            "success": "1784118787073"
          },
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
