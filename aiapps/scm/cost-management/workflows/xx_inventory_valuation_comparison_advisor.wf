        {
          "id": "1782374848142",
          "code": "PROCESS_ORGANIZATION_CONTEXT",
          "type": "CODE",
          "metadata": {
            "name": "Process Organization Context",
            "description": "Parses the provided app context so the next node can set the valuation period, cost book, and cost organization variables.",
            "sourceCode": "const context = $context.$app.$OraAppContext;\nconst values = context.trim().split(\":\");\n\nconst months = [\n  \"Jan\", \"Feb\", \"Mar\", \"Apr\", \"May\", \"Jun\",\n  \"Jul\", \"Aug\", \"Sep\", \"Oct\", \"Nov\", \"Dec\"\n];\n\nconst numericIdPattern = /^\\d+$/;\nconst periodPattern = /^([A-Za-z]{3})-(\\d{2})$/;\n\nconst periodMatch = periodPattern.exec(values[2] || \"\");\nconst monthIndex = periodMatch ? months.indexOf(periodMatch[1]) : -1;\n\nlet priorPeriodName = \"\";\nlet previousPeriodName = \"\";\n\nif (monthIndex !== -1) {\n  const year = 2000 + Number(periodMatch[2]);\n\n  priorPeriodName = `${months[monthIndex]}-${String(year - 1).slice(-2)}`;\n\n  const previousMonthIndex = monthIndex === 0 ? 11 : monthIndex - 1;\n  const previousMonthYear = monthIndex === 0 ? year - 1 : year;\n\n  previousPeriodName =\n    `${months[previousMonthIndex]}-${String(previousMonthYear).slice(-2)}`;\n}\n\nconst isValid =\n  values.length >= 3 &&\n  numericIdPattern.test(values[0]) &&\n  numericIdPattern.test(values[1]) &&\n  monthIndex !== -1;\n\nvalues[3] = priorPeriodName;\nvalues[4] = previousPeriodName;\nvalues[5] = isValid ? \"1\" : \"0\";\n\nreturn values;",
            "returnType": "array",
            "errorNodeId": "1782381843533"
          },
          "diagram": {
            "x": 6370,
            "y": 6094
          },
          "outcomes": {
            "success": "1783057828445"
          },
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
