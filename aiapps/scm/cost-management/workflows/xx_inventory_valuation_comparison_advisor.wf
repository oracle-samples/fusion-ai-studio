        {
          "id": "1782331709297",
          "code": "RETRIEVE_VALUATION_DATA",
          "type": "PARALLEL",
          "metadata": {
            "name": "Retrieve Valuation Data",
            "description": "Runs inventory valuation retrieval steps in parallel for asset, expense, and consigned valuation units."
          },
          "diagram": {
            "x": 5000,
            "y": 6982,
            "width": 2665,
            "height": 348
          },
          "outcomes": {
            "0": "1782329491624",
            "1": "1782331521084",
            "2": "1782331554521",
            "3": "1782331433293",
