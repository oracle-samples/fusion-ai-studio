        {
          "id": "1782331854047",
          "code": "PROCESS_INVENTORY_VALUATION_DATA",
          "type": "CODE",
          "metadata": {
            "name": "Process Inventory Valuation Data",
            "description": "Builds comparison rows for asset, expense, and consigned inventory values, including current, prior, year-ago, MoM, and YoY values.",
            "returnType": "object",
            "sourceCode": "const getItems = (nodeCode) => {\n  const items = $context.$nodes[nodeCode]?.$output?.items;\n  return Array.isArray(items) ? items : [];\n};\n\nconst getAmount = (record, fieldName) => {\n  if (!record || record[fieldName] === undefined || record[fieldName] === null || record[fieldName] === \"\") {\n    return \"\";\n  }\n\n  const amount = Number(record[fieldName]);\n  return Number.isFinite(amount) ? amount : \"\";\n};\n\nconst getPercentage = (currentAmount, comparisonAmount) => {\n  if (currentAmount === \"\" || comparisonAmount === \"\" || comparisonAmount === 0) {\n    return \"\";\n  }\n\n  return (((currentAmount - comparisonAmount) / comparisonAmount) * 100).toFixed(2) + \"%\";\n};\n\nconst categories = [\n  {\n    valuationType: \"Asset Inventory Value\",\n    current: getItems(\"GETINVENTORYASSETS\")[0],\n    priorYear: getItems(\"GETPRIORINVENTORYASSETS\")[0]\n  },\n  {\n    valuationType: \"Expense Inventory Value\",\n    current: getItems(\"GETINVENTORYEXPENSES\")[0],\n    priorYear: getItems(\"GETPRIORINVENTORYEXPENSES\")[0]\n  },\n  {\n    valuationType: \"Consigned Inventory Value\",\n    current: getItems(\"GETINVENTORYCONSIGNED\")[0],\n    priorYear: getItems(\"GETPRIORINVENTORYCONSIGNED\")[0]\n  }\n];\n\nconst columns = [\n  \"ValuationType\",\n  $context.$variables.PeriodName + \"(USD)\",\n  $context.$variables.PreviousPeriodName + \"(USD)\",\n  \"MoM\",\n  $context.$variables.PriorPeriodName + \"(USD)\",\n  \"YoY\"\n];\n\nconst rows = categories.map((category) => {\n  const currentValue = getAmount(category.current, \"InventoryValue\");\n  const previousMonthValue = getAmount(category.current, \"PriorInventoryValue\");\n  const priorYearValue = getAmount(category.priorYear, \"InventoryValue\");\n\n  return {\n    valuationType: category.valuationType,\n    currentValue,\n    previousMonthValue,\n    mom: getPercentage(currentValue, previousMonthValue),\n    priorYearValue,\n    yoy: getPercentage(currentValue, priorYearValue)\n  };\n});\n\nconst hasInventoryData = rows.some((row) =>\n  row.currentValue !== \"\" ||\n  row.previousMonthValue !== \"\" ||\n  row.priorYearValue !== \"\"\n);\n\nlet data =  {\n  columns,\n  rows\n};\nreturn{\n  data,\n  hasInventoryData\n};",
            "errorNodeId": "1782381843533"
          },
          "diagram": {
            "x": 6145,
            "y": 7480
          },
          "outcomes": {
            "success": "1785999534306"
          },
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
        {
          "id": "1785999534306",
