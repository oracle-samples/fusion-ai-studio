    "tools": [
      {
        "name": "GetExpiringInventoryLots",
        "description": "retrieves on-hand inventory lots for a specified inventory organization whose expiration dates fall within a date range beginning today, enabling warehouse and inventory teams to identify lots expiring in the coming days. Start Date, End Date and default OrganizationId are the required inputs",
        "operationId": "getall_itemQuantityLots",
        "operationType": "POST",
        "resourcePath": "/fscmRestApi/resources/11.13.18.05:9/inventoryItemLots/action/recommendationsForExpiryLots",
        "resourceType": "ADF_BC_FIXED_QUERY",
        "bodyTemplate": "{\n    \"input\": \"{\\\"LotExpirationStartDate\\\":\\\"{currentDate}\\\",\\\"LotExpirationEndDate\\\":\\\"{endDate}\\\",\\\"NoOfRecommendations\\\":10,\\\"Offset\\\":0,\\\"OnlyAvailableSKU\\\":true,\\\"OrganizationId\\\":\\\"{pOrganizationId}\\\"}\"\n\n}\n\n",
