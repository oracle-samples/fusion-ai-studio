        {
          "metadata": {
            "name": "Extract Organization Data",
            "description": "Extracts the selected organization's identifier, code, and name from the organization chooser response.",
            "returnType": "object",
            "sourceCode": "let result = {};\ntry {\n  let payload = $context.$nodes?.FETCH_DEFAULT_ORGANIZATION?.$output?.output;\n\n  if (typeof payload === \"string\") {\n    try {\n      payload = JSON.parse(payload);\n    } catch (parseError) {\n      // If JSON parsing fails, fallback to empty object\n      payload = {};\n    }\n  }\n\n  result = payload || {};\n} catch (error) {\n  result = {};\n}\n\nreturn result;"
          },
          "outcomes": {
            "success": "1770258926478"
          },
