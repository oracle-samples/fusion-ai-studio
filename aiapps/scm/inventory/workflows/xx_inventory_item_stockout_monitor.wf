        {
          "metadata": {
            "name": "Transform Stockout Data",
            "description": "Normalizes stockout item records into the display-ready structure used by the app.",
            "returnType": "array",
            "sourceCode": "let orgCode = $context.$variables.OrganizationCode;\n\n\nconst stockoutItems = (\n  $context &&\n  $context.$nodes &&\n  $context.$nodes.GET_LOCATION_STOCKOUT &&\n  $context.$nodes.GET_LOCATION_STOCKOUT.$output &&\n  Array.isArray($context.$nodes.GET_LOCATION_STOCKOUT.$output.items)\n) ? $context.$nodes.GET_LOCATION_STOCKOUT.$output.items : [];\n\nconst stockoutArray = (stockoutItems.length > 0)\n  ? stockoutItems.map(item => ({\n      OrganizationId: item.OrganizationId,\n      OrganizationCode: orgCode,\n      InventoryItemId: item.InventoryItemId,\n      ItemNumber: item.ItemNumber,\n      Subinventory: item.Subinventory,\n      InboundSupplyAvailableFlag: item.InboundSupplyAvailableFlag,\n      AvailableElsewhereFlag: item.AvailableElsewhereFlag,\n      SubstituteItemAvailableFlag: item.SubstituteItemAvailableFlag,\n      ItemMinimumValue:item.ItemMinimumValue,\n      ItemMaximumValue:item.ItemMaximumValue,\n      PrimaryUnitOfMeasure:item.PrimaryUnitOfMeasure,\n      LocatorName:null,\n      Context: \"Stockout\"\n    }))\n  : [];\n\n\n\nlet combinedArray = [];\ncombinedArray = combinedArray.concat(stockoutArray);\nreturn combinedArray;"
          },
          "outcomes": {
            "success": "1767596189172"
          },
          "code": "TRANSFORM_STOCKOUT_DATA",
          "id": "1766992643694",
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}",
          "type": "CODE",
          "diagram": {
            "x": 5024,
            "y": 6538
          }
        },
