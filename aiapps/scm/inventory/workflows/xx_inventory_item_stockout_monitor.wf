          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"description\": \"\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"items\": {\n      \"type\": \"array\",\n      \"uniqueItems\": true,\n      \"minItems\": 1,\n      \"items\": {\n        \"required\": [\n          \"RuleConfigurationHeaderId\",\n          \"RuleType\",\n          \"OrganizationId\",\n          \"OrganizationCode\",\n          \"Context1\",\n          \"ContextValue1\",\n          \"DefaultValue\",\n          \"DefaultValueName\",\n          \"Module\",\n          \"LastRefreshedDate\",\n          \"LastRefreshedDateTime\"\n        ],\n        \"properties\": {\n          \"RuleConfigurationHeaderId\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"RuleType\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"OrganizationId\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"OrganizationCode\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"Context1\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"ContextValue1\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"DefaultValue\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"DefaultValueName\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"Module\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"LastRefreshedDate\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"LastRefreshedDateTime\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"@context\": {\n            \"type\": \"object\",\n            \"properties\": {\n              \"key\": {\n                \"type\": \"string\",\n                \"minLength\": 1\n              },\n              \"headers\": {\n                \"type\": \"object\",\n                \"properties\": {\n                  \"ETag\": {\n                    \"type\": \"string\",\n                    \"minLength\": 1\n                  }\n                },\n                \"required\": [\n                  \"ETag\"\n                ]\n              }\n            },\n            \"required\": [\n              \"key\",\n              \"headers\"\n            ]\n          }\n        }\n      }\n    },\n    \"count\": {\n      \"type\": \"number\"\n    },\n    \"hasMore\": {\n      \"type\": \"boolean\"\n    },\n    \"limit\": {\n      \"type\": \"number\"\n    },\n    \"offset\": {\n      \"type\": \"number\"\n    },\n    \"links\": {\n      \"type\": \"array\",\n      \"uniqueItems\": true,\n      \"minItems\": 1,\n      \"items\": {\n        \"required\": [\n          \"rel\",\n          \"href\",\n          \"name\",\n          \"kind\"\n        ],\n        \"properties\": {\n          \"rel\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"href\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"name\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          },\n          \"kind\": {\n            \"type\": \"string\",\n            \"minLength\": 1\n          }\n        }\n      }\n    }\n  },\n  \"required\": [\n    \"items\",\n    \"count\",\n    \"hasMore\",\n    \"limit\",\n    \"offset\",\n    \"links\"\n  ]\n}",
