      {
        "name": "fetchOverduePurchaseOrders",
        "description": "Retrieves overdue purchase orders.",
        "operationType": "POST",
        "resourcePath": "/fscmRestApi/procurement/11.13.18.05/orderSearches",
        "resourceType": "ADF_BC_FIXED_QUERY",
        "bodyTemplate": "{\n  \"filters\": [\n    {\n      \"name\": \"Overdue\",\n      \"value\": true\n    },\n    {\n      \"name\": \"OrderDate\",\n      \"rangeStart\": \"{startDate}\",\n      \"rangeEnd\": \"{endDate}\"\n    }\n  ],\n  \"displayFields\": [\n    \"OrderNumber\", \"Status\", \"StatusCode\", \"RequisitioningBU\", \"ProcurementBU\", \"Total\", \"Currency\", \"Buyer\", \"Supplier\", \"Requester\", \"ShipToLocation\", \"BillToLocation\", \"CreationDate\"\n  ],\n  \"offset\": 0,\n  \"limit\": 10,\n  \"sort\": [\n    {\n      \"name\": \"Total\",\n      \"direction\": \"desc\"\n    },\n    {\n      \"name\": \"CreationDate\",\n      \"direction\": \"asc\"\n    }\n  ]\n}",
        "useNativeAuthentication": true,
        "type": "BUS_OBJECT",
        "parameterDefinitions": [
