    "tools": [
      {
        "name": "fetchPurchaseOrderCounts",
        "description": "Retrieves purchase order counts for key categories.",
        "operationType": "POST",
        "resourcePath": "/fscmRestApi/applcoreApi/search/v1/fa-prc-po?parameters=0&searchType=search&size=0",
        "resourceType": "ADF_BC_FIXED_QUERY",
        "bodyTemplate": "{\n    \"track_total_hits\": true,\n    \"query\": {\n        \"range\": {\n            \"orderDate\": {\n                \"gte\": \"{startDate}\",\n                \"lte\": \"{endDate}\"\n            }\n        }\n    },\n    \"aggs\": {\n        \"agg_by_onlineReportId\": {\n            \"filter\": {\n                \"bool\": {\n                    \"must\": [\n                        {\n                            \"exists\": {\n                                \"field\": \"onlineReportId\"\n                            }\n                        }\n                    ]\n                }\n            }\n        },\n        \"agg_by_draftStatusCode\": {\n            \"filter\": {\n                \"bool\": {\n                    \"must\": [\n                        {\n                            \"exists\": {\n                                \"field\": \"draftStatusCode\"\n                            }\n                        }\n                    ]\n                }\n            }\n        },\n        \"agg_by_dueDate\": {\n            \"nested\": {\n                \"path\": \"lines.schedules\"\n            },\n            \"aggs\": {\n                \"agg_overdue\": {\n                    \"filter\": {\n                        \"bool\": {\n                            \"must\": [\n                                {\n                                    \"terms\": {\n                                        \"lines.schedules.status\": [\n                                            \"OPEN\",\n                                            \"CLOSED FOR INVOICING\",\n                                            \"ON HOLD\"\n                                        ]\n                                    }\n                                },\n                                {\n                                    \"range\": {\n                                        \"lines.schedules.dueDate\": {\n                                            \"lt\": \"now/d\"\n                                        }\n                                    }\n                                }\n                            ]\n                        }\n                    },\n                    \"aggs\": {\n                        \"count_headers\": {\n                            \"reverse_nested\": {},\n                            \"aggs\": {\n                                \"header_count\": {\n                                    \"value_count\": {\n                                        \"field\": \"poHeaderId\"\n                                    }\n                                }\n                            }\n                        }\n                    }\n                }\n            }\n        },\n        \"agg_by_invoiceHold\": {\n            \"nested\": {\n                \"path\": \"lines.schedules.invoiceHolds\"\n            },\n            \"aggs\": {\n                \"agg_invoiceHold\": {\n                    \"filter\": {\n                        \"bool\": {\n                            \"must\": [\n                                {\n                                    \"exists\": {\n                                        \"field\": \"lines.schedules.invoiceHolds.poHoldCode\"\n                                    }\n                                },\n                                {\n                                    \"term\": {\n                                        \"lines.schedules.invoiceHolds.releaseLookupCode\": \"NOT_RELEASED\"\n                                    }\n                                }\n                            ]\n                        }\n                    },\n                    \"aggs\": {\n                        \"count_headers\": {\n                            \"reverse_nested\": {},\n                            \"aggs\": {\n                                \"header_count\": {\n                                    \"value_count\": {\n                                        \"field\": \"poHeaderId\"\n                                    }\n                                }\n                            }\n                        }\n                    }\n                }\n            }\n        }\n    }\n}",
        "useNativeAuthentication": true,
        "type": "BUS_OBJECT",
        "parameterDefinitions": [
          {
            "name": "startDate",
            "dataType": "string",
            "description": "Start date.",
            "id": 2,
            "isToken": true,
            "location": "body",
            "source": "placeholder",
            "defaultValue": ""
          },
          {
            "name": "endDate",
            "dataType": "string",
            "description": "End date.",
            "id": 3,
            "isToken": true,
            "location": "body",
            "source": "placeholder",
            "defaultValue": ""
          }
        ],
        "sampleQueries": [
          {
            "description": "Sample response with purchase order counts.",
            "query": {
              "took": "<took>",
              "timed_out": "<timed_out>",
              "_shards": {
                "total": "<total>",
                "successful": "<successful>",
                "skipped": "<skipped>",
                "failed": "<failed>"
              },
              "aggregations": {
                "agg_by_invoiceHold": {
                  "doc_count": "<doc_count>",
                  "agg_invoiceHold": {
                    "doc_count": "<doc_count>",
                    "count_headers": {
                      "doc_count": "<doc_count>",
                      "header_count": {
                        "value": "<value>"
                      }
                    }
                  }
                },
                "agg_by_draftStatusCode": {
                  "doc_count": "<doc_count>"
                },
                "agg_by_dueDate": {
                  "doc_count": "<doc_count>",
                  "agg_overdue": {
                    "doc_count": "<doc_count>",
                    "count_headers": {
                      "doc_count": "<doc_count>",
                      "header_count": {
                        "value": "<value>"
                      }
                    }
                  }
                },
                "agg_by_onlineReportId": {
                  "doc_count": "<doc_count>"
                }
              },
              "totalResults": "<totalResults>",
              "max_score": "<max_score>",
              "limit": "<limit>",
              "offset": "<offset>",
              "hasMore": "<hasMore>",
              "items": [],
              "count": "<count>"
            },
            "sampleType": "response"
          }
        ]
