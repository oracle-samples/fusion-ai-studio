            "location": "body",
            "source": "placeholder",
            "defaultValue": ""
          }
        ],
        "sampleQueries": [
          {
            "description": "Example response for retrieving expiring purchase agreement counts.",
            "query": {
              "facets": [
                {
                  "name": "<facetName>",
                  "values": [
                    {
                      "value": "<value1>",
                      "count": "<count1>",
                      "displayValue": "<displayValue1>"
                    },
                    {
                      "value": "<value2>",
