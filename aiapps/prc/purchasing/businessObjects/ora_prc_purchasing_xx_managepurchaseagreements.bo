    "tools": [
      {
        "name": "fetchPurchaseAgreementCounts",
        "description": "Retrieves purchase agreement counts for the reporting period, including online-report and draft-status agreements.",
        "operationType": "POST",
        "resourcePath": "/fscmRestApi/applcoreApi/search/v1/fa-prc-pa?parameters=0&searchType=search&size=0",
        "resourceType": "ADF_BC_FIXED_QUERY",
        "bodyTemplate": "{\n    \"track_total_hits\": true,\n    \"query\": {\n        \"range\": {\n            \"agreementDate\": {\n                \"gte\": \"{startDate}\",\n                \"lte\": \"{endDate}\"\n            }\n        }\n    },\n    \"aggs\": {\n        \"agg_by_draftStatusCode\": {\n            \"filter\": {\n                \"bool\": {\n                    \"must\": [\n                        {\n                            \"exists\": {\n                                \"field\": \"draftStatusCode\"\n                            }\n                        }\n                    ]\n                }\n            }\n        },\n        \"agg_by_onlineReportId\": {\n            \"filter\": {\n                \"bool\": {\n                    \"must\": [\n                        {\n                            \"exists\": {\n                                \"field\": \"onlineReportId\"\n                            }\n                        }\n                    ]\n                }\n            }\n        }\n    }\n}",
        "useNativeAuthentication": true,
        "type": "BUS_OBJECT",
        "parameterDefinitions": [
          {
            "name": "startDate",
            "dataType": "date",
            "description": "Start date for the reporting period.",
            "id": 2,
            "isToken": true,
            "location": "body",
            "source": "placeholder",
            "defaultValue": ""
          },
          {
            "name": "endDate",
            "dataType": "date",
            "description": "End date for the reporting period.",
            "id": 3,
            "isToken": true,
            "location": "body",
            "source": "placeholder",
            "defaultValue": ""
          }
        ],
        "sampleQueries": [
          {
            "description": "Example response for retrieving purchase agreement summary counts.",
            "query": {
              "took": "<took>",
              "timed_out": "<timed_out>",
              "_shards": {
                "total": "<total>",
                "successful": "<successful>",
                "skipped": "<skipped>",
                "failed": "<failed>"
              },
              "aggregations": {
                "agg_by_draftStatusCode": {
                  "doc_count": "<doc_count>"
                },
                "agg_by_onlineReportId": {
                  "doc_count": "<doc_count>"
                }
              },
              "totalResults": "<totalResults>",
              "max_score": "<max_score>",
              "limit": "<limit>",
              "offset": "<offset>",
              "hasMore": "<hasMore>",
              "items": [],
              "count": "<count>"
            },
            "sampleType": "response"
          }
        ]
      },
      {
        "name": "fetchAllPurchaseAgreements",
        "description": "Retrieves purchase agreements.",
        "operationType": "POST",
        "resourcePath": "/fscmRestApi/procurement/11.13.18.05/agreementSearches",
        "resourceType": "ADF_BC_FIXED_QUERY",
        "bodyTemplate": "{\n  \"filters\": [\n    {\"name\":\"IncludeClosedAndExpiredDocuments\",\"value\":\"true\"},\n    {\"name\":\"AgreementDate\",\"rangeStart\":\"{startDate}\",\"rangeEnd\":\"{endDate}\"}\n  ],\n  \"displayFields\":[\"AgreementNumber\",\"Status\",\"StatusCode\",\"Description\",\"DocumentTypeShort\",\"AgreementAmount\",\"ReleasedAmount\",\"Currency\",\"StartDate\",\"EndDate\",\"Buyer\",\"Supplier\",\"ProcurementBU\"],\n  \"offset\":0,\"limit\":10,\n  \"sort\":[{\"name\":\"AgreementAmount\",\"direction\":\"desc\"},{\"name\":\"CreationDate\",\"direction\":\"asc\"}]\n}",
        "useNativeAuthentication": true,
        "type": "BUS_OBJECT",
        "parameterDefinitions": [
          {
            "name": "startDate",
            "dataType": "date",
            "description": "Start date for the reporting period.",
            "id": 6,
            "isToken": true,
            "location": "body",
            "source": "placeholder",
