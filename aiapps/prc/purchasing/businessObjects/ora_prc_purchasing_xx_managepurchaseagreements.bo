            "defaultValue": ""
          },
          {
            "name": "endDate",
            "dataType": "date",
            "description": "End date for the reporting period.",
            "id": 11,
            "isToken": true,
            "location": "body",
            "source": "placeholder",
            "defaultValue": ""
          }
        ],
        "sampleQueries": [
          {
            "description": "Example response for retrieving purchase agreement status counts.",
            "query": {
              "facets": [
                {
                  "name": "<name>",
                  "values": [
                    {
                      "value": "<value>",
                      "count": "<count>",
                      "displayValue": "<displayValue>"
                    }
                  ]
                }
              ]
            },
            "sampleType": "response"
          }
        ]
