        "bodyTemplate": "{\n    \"filters\": [\n        {\n            \"name\": \"IncludeClosedAndExpiredDocuments\",\n            \"value\": \"true\"\n        },\n        {\n          \"name\": \"AgreementDate\",\n          \"rangeStart\": \"{startDate}\",\n          \"rangeEnd\": \"{endDate}\"\n        }\n    ],\n    \"additionalContext\": {\n        \"agreementColumns\": {},\n        \"lineColumns\": {},\n        \"savedKpi\": \"all\",\n        \"savedContext\": \"Agreements\"\n    },\n    \"facets\": [\n        \"AgreementStatus\"\n    ]\n}",
        "useNativeAuthentication": true,
        "type": "BUS_OBJECT",
        "parameterDefinitions": [
          {
            "name": "startDate",
