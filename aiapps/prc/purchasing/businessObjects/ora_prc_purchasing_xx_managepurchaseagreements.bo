      {
        "name": "fetchExpiringPurchaseAgreementCounts",
        "description": "Retrieves counts of purchase agreements approaching expiration for the reporting period.",
        "operationType": "POST",
        "resourcePath": "/fscmRestApi/procurement/11.13.18.05/agreementAggregations",
        "resourceType": "ADF_BC_FIXED_QUERY",
        "bodyTemplate": "{\n    \"context\": \"All\",\n    \"facets\": [\n        \"DaysToExpire\"\n    ],\n    \"filters\": [\n        {\n            \"name\": \"IncludeClosedAndExpiredDocuments\",\n            \"value\": true\n        },\n        {\n            \"name\": \"ExcludeClosedAndCancelledDocuments\",\n            \"value\": true\n        },\n        {\n          \"name\": \"AgreementDate\",\n          \"rangeStart\": \"{startDate}\",\n          \"rangeEnd\": \"{endDate}\"\n        }\n    ]\n}",
        "useNativeAuthentication": true,
