        {
          "id": "4",
          "code": "PROCESS_PURCHASE_AGREEMENT_SUMMARY",
          "type": "CODE",
          "metadata": {
            "name": "Process Purchase Agreement Summary",
            "description": "Processes purchase agreement counts for display.",
            "returnType": "array",
            "sourceCode": "const input = $context.$nodes.FETCH_PURCHASE_AGREEMENT_SUMMARY_DATA.$output;\nconst inputExp = $context.$nodes.FETCH_EXPIRING_PURCHASE_AGREEMENT_DATA.$output;\n\nconst expCount = inputExp.facets.find(facet => facet.name === \"DaysToExpire\")?.values.find(item => item.value === \"LESS_THAN_30\")?.count;\n\nconst summary = [\n  {\n    name: \"Draft and Rejected\",\n    value: input.aggregations.agg_by_draftStatusCode.doc_count,\n    action: 'ora.invoke(\"fetchPAs\", \"DRAFTS_AND_REJECTED\")'\n  },\n  {\n    name: \"Processing Errors\",\n    value: input.aggregations.agg_by_onlineReportId.doc_count,\n    action: 'ora.invoke(\"fetchPAs\", \"PROCESSING_ERRORS\")'\n  },\n  {\n    name: \"Expiring in 30 days\",\n    value: expCount,\n    action: 'ora.invoke(\"fetchPAs\", \"EXPIRING_IN_30_DAYS\")'\n  }\n];\nsummary.sort((a,b) => (b.value ?? 0) - (a.value ?? 0));\nreturn summary;",
            "errorNodeId": "1"
          },
          "outcomes": {
            "success": "1785246549771"
          },
          "inputs": [],
          "diagram": {
            "x": 7340,
            "y": 6094
          },
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
