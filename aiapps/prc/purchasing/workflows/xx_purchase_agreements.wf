        {
          "id": "1785400000001",
          "code": "RESOLVE_PURCHASE_AGREEMENT_SELECTION",
          "type": "CODE",
          "metadata": {
            "name": "Resolve Purchase Agreement Selection",
            "description": "Resolves the selected purchase agreement view.",
            "errorNodeId": "1",
            "returnType": "object",
            "sourceCode": "const actionCode = String($context.$app.$OraAction || \"\").trim();\nconst selectionNames = { ALL: \"Purchase Agreements\", DRAFTS_AND_REJECTED: \"Draft and Rejected\", PROCESSING_ERRORS: \"Processing Errors\", EXPIRING_IN_30_DAYS: \"Expiring in 30 days\" };\nconst name = selectionNames[actionCode];\nif (!name) { throw new Error(\"Unsupported purchase agreement action.\"); }\nreturn { name: name };"
          },
          "outcomes": {
            "success": "1785400000011"
          },
          "inputs": [],
          "diagram": {
