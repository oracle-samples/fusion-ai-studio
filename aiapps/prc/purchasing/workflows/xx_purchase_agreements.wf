        {
          "id": "7",
          "code": "PROCESS_PURCHASE_AGREEMENTS",
          "type": "CODE",
          "metadata": {
            "name": "Process Purchase Agreements",
            "description": "Processes purchase agreement details for display.",
            "returnType": "object",
            "sourceCode": "const selectionName = $context.$nodes.RESOLVE_PURCHASE_AGREEMENT_SELECTION.$output.result.name;\nconst agreementItems = { \"Purchase Agreements\": $context.$nodes.FETCH_ALL_PURCHASE_AGREEMENTS?.$output?.items, \"Draft and Rejected\": $context.$nodes.FETCH_DRAFT_AND_REJECTED_PURCHASE_AGREEMENTS?.$output?.items, \"Processing Errors\": $context.$nodes.FETCH_PURCHASE_AGREEMENTS_WITH_PROCESSING_ERRORS?.$output?.items, \"Expiring in 30 days\": $context.$nodes.FETCH_PURCHASE_AGREEMENTS_EXPIRING_IN_30_DAYS?.$output?.items };\nconst input = agreementItems[selectionName] || [];\n\nconst formatDate = (value) => {\n  if (value == null || String(value).trim() === \"\") {\n    return \"\";\n  }\n\n  const datePart = String(value).split(\"T\")[0];\n  const parts = datePart.split(\"-\");\n\n  return parts.length === 3 ? `${parts[2]}/${parts[1]}/${parts[0]}` : datePart;\n};\n\nconst formatAmount = (amount, currency) => {\n  if (amount == null || String(amount).trim() === \"\") {\n    return \"\";\n  }\n\n  const numericAmount = Number(String(amount).replace(/,/g, \"\").trim());\n\n  if (!Number.isFinite(numericAmount)) {\n    return \"\";\n  }\n\n  const formattedAmount = numericAmount\n    .toFixed(2)\n    .replace(/\\B(?=(\\d{3})+(?!\\d))/g, \",\");\n\n  return currency == null || String(currency).trim() === \"\"\n    ? formattedAmount\n    : `${formattedAmount} ${currency}`;\n};\n\nreturn input.map((item) => ({\n  \"Agreement\": item.AgreementNumber,\n  \"Status\": item.Status,\n  \"StatusCode\": item.StatusCode,\n  \"Description\": item.Description,\n  \"Type\": item.DocumentTypeShort,\n  \"Agreement Amount\": formatAmount(item.AgreementAmount, item.Currency),\n  \"Released Amount\": formatAmount(item.ReleasedAmount, item.Currency),\n  \"Start Date\": formatDate(item.StartDate),\n  \"End Date\": formatDate(item.EndDate),\n  \"Buyer\": item.Buyer,\n  \"Supplier\": item.Supplier,\n  \"Procurement BU\": item.ProcurementBU\n}));",
            "errorNodeId": "1"
          },
          "outcomes": {
            "success": "1785307277611"
          },
          "inputs": [],
          "diagram": {
            "x": 5930,
            "y": 6316
          },
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
