          },
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-07/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"items\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"AgreementNumber\": {\n            \"type\": \"string\"\n          },\n          \"StatusCode\": {\n            \"type\": \"string\"\n          },\n          \"Status\": {\n            \"type\": \"string\"\n          },\n          \"DraftStatus\": {\n            \"type\": \"string\"\n          },\n          \"DraftStatusCode\": {\n            \"type\": \"string\"\n          },\n          \"Description\": {\n            \"type\": \"string\"\n          },\n          \"DocumentTypeShort\": {\n            \"type\": \"string\"\n          },\n          \"Supplier\": {\n            \"type\": \"string\"\n          },\n          \"AgreementAmount\": {\n            \"type\": \"string\"\n          },\n          \"ReleasedAmount\": {\n            \"type\": \"string\"\n          },\n          \"StartDate\": {\n            \"type\": \"string\"\n          },\n          \"EndDate\": {\n            \"type\": \"string\"\n          },\n          \"Buyer\": {\n            \"type\": \"string\"\n          },\n          \"BuyerId\": {\n            \"type\": \"string\"\n          },\n          \"ProcurementBU\": {\n            \"type\": \"string\"\n          },\n          \"ProcurementBUId\": {\n            \"type\": \"string\"\n          },\n          \"Revision\": {\n            \"type\": \"string\"\n          },\n          \"RevisionDate\": {\n            \"type\": \"string\"\n          },\n          \"ChangeOrder\": {\n            \"type\": \"string\"\n          },\n          \"ChangeOrderStatus\": {\n            \"type\": \"string\"\n          },\n          \"ChangeOrderStatusCode\": {\n            \"type\": \"string\"\n          },\n          \"SupplierSite\": {\n            \"type\": \"string\"\n          },\n          \"SupplierContact\": {\n            \"type\": \"string\"\n          },\n          \"ClosedDate\": {\n            \"type\": \"string\"\n          },\n          \"DocumentStyle\": {\n            \"type\": \"string\"\n          },\n          \"CreationDate\": {\n            \"type\": \"string\"\n          },\n          \"LastUpdateDate\": {\n            \"type\": \"string\"\n          },\n          \"MasterContract\": {\n            \"type\": \"string\"\n          },\n          \"NoteToSupplier\": {\n            \"type\": \"string\"\n          },\n          \"NotetoReceiver\": {\n            \"type\": \"string\"\n          },\n          \"MinimumReleaseAmount\": {\n            \"type\": \"string\"\n          },\n          \"AcknowledgmentDueDate\": {\n            \"type\": \"string\"\n          },\n          \"AgreementDate\": {\n            \"type\": \"string\"\n          },\n          \"AcceptanceDueDate\": {\n            \"type\": \"string\"\n          },\n          \"Priority\": {\n            \"type\": \"string\"\n          },\n          \"Currency\": {\n            \"type\": \"string\"\n          },\n          \"AgreementId\": {\n            \"type\": \"string\"\n          },\n          \"ShippingMethod\": {\n            \"type\": \"string\"\n          },\n          \"DraftVersionCreationDate\": {\n            \"type\": \"string\"\n          },\n          \"CarrierName\": {\n            \"type\": \"string\"\n          },\n          \"ModeOfTransport\": {\n            \"type\": \"string\"\n          },\n          \"ServiceLevel\": {\n            \"type\": \"string\"\n          },\n          \"ReferenceNumber\": {\n            \"type\": \"string\"\n          },\n          \"ContractNumber\": {\n            \"type\": \"string\"\n          },\n          \"ContractId\": {\n            \"type\": \"string\"\n          },\n          \"CurrencyPrecision\": {\n            \"type\": \"string\"\n          },\n          \"OnlineReportId\": {\n            \"type\": \"string\"\n          },\n          \"FrozenFlag\": {\n            \"type\": \"string\"\n          },\n          \"ChangeOrderAcceptanceDueDate\": {\n            \"type\": \"string\"\n          },\n          \"DocumentTypeCode\": {\n            \"type\": \"string\"\n          },\n          \"SupplierSiteHoldFlag\": {\n            \"type\": \"string\"\n          },\n          \"ChangeOrderOriginatorRoleCode\": {\n            \"type\": \"string\"\n          },\n          \"AmountLimit\": {\n            \"type\": \"string\"\n          },\n          \"ConfirmingOrderFlag\": {\n            \"type\": \"string\"\n          },\n          \"AuthoringDate\": {\n            \"type\": \"string\"\n          },\n          \"PriceUpdateTolerance\": {\n            \"type\": \"string\"\n          },\n          \"SupplierAgreement\": {\n            \"type\": \"string\"\n          },\n          \"TransferredTo\": {\n            \"type\": \"string\"\n          },\n          \"ChangeOrderDate\": {\n            \"type\": \"string\"\n          },\n          \"ContractTemplate\": {\n            \"type\": \"string\"\n          },\n          \"CatalogAdminAuthEnabled\": {\n            \"type\": \"string\"\n          },\n          \"AttachmentExistsFlag\": {\n            \"type\": \"string\"\n          },\n          \"SupplierId\": {\n            \"type\": \"string\"\n          },\n          \"SupplierSiteId\": {\n            \"type\": \"string\"\n          },\n          \"SupplierSiteContactId\": {\n            \"type\": \"string\"\n          },\n          \"ConfiguredItemFlag\": {\n            \"type\": \"string\"\n          },\n          \"UploadLinesJobStatusCode\": {\n            \"type\": \"string\"\n          },\n          \"InitialVersionPendingResponseRole\": {\n            \"type\": \"string\"\n          },\n          \"headerDFF._Purchasing__Document__Headers__DF\": {\n            \"type\": \"string\"\n          },\n          \"headerDFF.testText\": {\n            \"type\": \"string\"\n          },\n          \"DaysInDraft\": {\n            \"type\": \"string\"\n          },\n          \"DaysToExpire\": {\n            \"type\": \"string\"\n          },\n          \"DaysPendingAuthoring\": {\n            \"type\": \"string\"\n          },\n          \"IconType\": {\n            \"type\": \"string\"\n          }\n        },\n        \"required\": [\n          \"AgreementNumber\",\n          \"StatusCode\",\n          \"Status\",\n          \"DraftStatus\",\n          \"DraftStatusCode\",\n          \"Description\",\n          \"DocumentTypeShort\",\n          \"Supplier\",\n          \"AgreementAmount\",\n          \"ReleasedAmount\",\n          \"StartDate\",\n          \"EndDate\",\n          \"Buyer\",\n          \"BuyerId\",\n          \"ProcurementBU\",\n          \"ProcurementBUId\",\n          \"Revision\",\n          \"RevisionDate\",\n          \"ChangeOrder\",\n          \"ChangeOrderStatus\",\n          \"ChangeOrderStatusCode\",\n          \"SupplierSite\",\n          \"SupplierContact\",\n          \"ClosedDate\",\n          \"DocumentStyle\",\n          \"CreationDate\",\n          \"LastUpdateDate\",\n          \"MasterContract\",\n          \"NoteToSupplier\",\n          \"NotetoReceiver\",\n          \"MinimumReleaseAmount\",\n          \"AcknowledgmentDueDate\",\n          \"AgreementDate\",\n          \"AcceptanceDueDate\",\n          \"Priority\",\n          \"Currency\",\n          \"AgreementId\",\n          \"ShippingMethod\",\n          \"DraftVersionCreationDate\",\n          \"CarrierName\",\n          \"ModeOfTransport\",\n          \"ServiceLevel\",\n          \"ReferenceNumber\",\n          \"ContractNumber\",\n          \"ContractId\",\n          \"CurrencyPrecision\",\n          \"OnlineReportId\",\n          \"FrozenFlag\",\n          \"ChangeOrderAcceptanceDueDate\",\n          \"DocumentTypeCode\",\n          \"SupplierSiteHoldFlag\",\n          \"ChangeOrderOriginatorRoleCode\",\n          \"AmountLimit\",\n          \"ConfirmingOrderFlag\",\n          \"AuthoringDate\",\n          \"PriceUpdateTolerance\",\n          \"SupplierAgreement\",\n          \"TransferredTo\",\n          \"ChangeOrderDate\",\n          \"ContractTemplate\",\n          \"CatalogAdminAuthEnabled\",\n          \"AttachmentExistsFlag\",\n          \"SupplierId\",\n          \"SupplierSiteId\",\n          \"SupplierSiteContactId\",\n          \"ConfiguredItemFlag\",\n          \"UploadLinesJobStatusCode\",\n          \"InitialVersionPendingResponseRole\",\n          \"headerDFF._Purchasing__Document__Headers__DF\",\n          \"headerDFF.testText\",\n          \"DaysInDraft\",\n          \"DaysToExpire\",\n          \"DaysPendingAuthoring\",\n          \"IconType\"\n        ],\n        \"additionalProperties\": false\n      }\n    },\n    \"totalResults\": {\n      \"type\": \"string\"\n    },\n    \"count\": {\n      \"type\": \"string\"\n    },\n    \"limit\": {\n      \"type\": \"string\"\n    },\n    \"offset\": {\n      \"type\": \"string\"\n    },\n    \"hasMore\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"items\",\n    \"totalResults\",\n    \"count\",\n    \"limit\",\n    \"offset\",\n    \"hasMore\"\n  ],\n  \"additionalProperties\": false\n}"
