          "type": "LLM",
          "metadata": {
            "name": "Display Purchase Agreement Retrieval Error",
            "description": "Displays a message when purchase agreement information cannot be retrieved.",
            "modelConfiguration": {
              "code": "ORA_LLM_PREMIUM",
              "modelName": "GPT-4.1 Mini (Premium)",
              "provider": "CERT_PREMIUM",
              "model": "OPEN_AI_GPT_4_1_MINI",
              "modelProperties": {
                "k": 0,
                "max_tokens": 32000,
                "p": 0.75
              }
            }
          },
          "outcomes": {
            "success": "end"
          },
          "inputs": [
            {
              "id": "1_prompt",
              "name": "prompt",
              "type": "string",
              "value": "Generate one valid oraInfoDisplay response using messageListWidget. Explain in one concise professional sentence that purchase agreement information cannot be displayed right now and suggest trying again later. Use no title, items, actions, links, technical details, or content outside the oraInfoDisplay output."
            },
            {
              "id": "1_systemPrompt",
              "name": "systemPrompt",
              "type": "string",
              "value": "return {{$context.$system.$currentDate}}.slice(0, 5) + String(+{{$context.$system.$currentDate}}.slice(5, 7) - 1).padStart(2, \"0\") + {{$context.$system.$currentDate}}.slice(7);"
            }
          ],
          "diagram": {
            "x": 7833,
            "y": 5000
          },
          "aiAppOutputSpecification": {
            "dataDisplay": {
              "layouts": [
                "ORA_LAYOUT_MESSAGES_LIST"
              ],
              "customNotes": "Use messageListWidget for a description-only purchase agreement retrieval error."
            }
          }
