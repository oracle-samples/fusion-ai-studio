          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-07/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"took\": {\n      \"type\": \"string\"\n    },\n    \"timed_out\": {\n      \"type\": \"string\"\n    },\n    \"_shards\": {\n      \"type\": \"object\",\n      \"properties\": {\n        \"total\": {\n          \"type\": \"string\"\n        },\n        \"successful\": {\n          \"type\": \"string\"\n        },\n        \"skipped\": {\n          \"type\": \"string\"\n        },\n        \"failed\": {\n          \"type\": \"string\"\n        }\n      },\n      \"required\": [\n        \"total\",\n        \"successful\",\n        \"skipped\",\n        \"failed\"\n      ],\n      \"additionalProperties\": false\n    },\n    \"aggregations\": {\n      \"type\": \"object\",\n      \"properties\": {\n        \"agg_by_invoiceHold\": {\n          \"type\": \"object\",\n          \"properties\": {\n            \"doc_count\": {\n              \"type\": \"string\"\n            },\n            \"agg_invoiceHold\": {\n              \"type\": \"object\",\n              \"properties\": {\n                \"doc_count\": {\n                  \"type\": \"string\"\n                },\n                \"count_headers\": {\n                  \"type\": \"object\",\n                  \"properties\": {\n                    \"doc_count\": {\n                      \"type\": \"string\"\n                    },\n                    \"header_count\": {\n                      \"type\": \"object\",\n                      \"properties\": {\n                        \"value\": {\n                          \"type\": \"string\"\n                        }\n                      },\n                      \"required\": [\n                        \"value\"\n                      ],\n                      \"additionalProperties\": false\n                    }\n                  },\n                  \"required\": [\n                    \"doc_count\",\n                    \"header_count\"\n                  ],\n                  \"additionalProperties\": false\n                }\n              },\n              \"required\": [\n                \"doc_count\",\n                \"count_headers\"\n              ],\n              \"additionalProperties\": false\n            }\n          },\n          \"required\": [\n            \"doc_count\",\n            \"agg_invoiceHold\"\n          ],\n          \"additionalProperties\": false\n        },\n        \"agg_by_draftStatusCode\": {\n          \"type\": \"object\",\n          \"properties\": {\n            \"doc_count\": {\n              \"type\": \"string\"\n            }\n          },\n          \"required\": [\n            \"doc_count\"\n          ],\n          \"additionalProperties\": false\n        },\n        \"agg_by_dueDate\": {\n          \"type\": \"object\",\n          \"properties\": {\n            \"doc_count\": {\n              \"type\": \"string\"\n            },\n            \"agg_overdue\": {\n              \"type\": \"object\",\n              \"properties\": {\n                \"doc_count\": {\n                  \"type\": \"string\"\n                },\n                \"count_headers\": {\n                  \"type\": \"object\",\n                  \"properties\": {\n                    \"doc_count\": {\n                      \"type\": \"string\"\n                    },\n                    \"header_count\": {\n                      \"type\": \"object\",\n                      \"properties\": {\n                        \"value\": {\n                          \"type\": \"string\"\n                        }\n                      },\n                      \"required\": [\n                        \"value\"\n                      ],\n                      \"additionalProperties\": false\n                    }\n                  },\n                  \"required\": [\n                    \"doc_count\",\n                    \"header_count\"\n                  ],\n                  \"additionalProperties\": false\n                }\n              },\n              \"required\": [\n                \"doc_count\",\n                \"count_headers\"\n              ],\n              \"additionalProperties\": false\n            }\n          },\n          \"required\": [\n            \"doc_count\",\n            \"agg_overdue\"\n          ],\n          \"additionalProperties\": false\n        },\n        \"agg_by_onlineReportId\": {\n          \"type\": \"object\",\n          \"properties\": {\n            \"doc_count\": {\n              \"type\": \"string\"\n            }\n          },\n          \"required\": [\n            \"doc_count\"\n          ],\n          \"additionalProperties\": false\n        }\n      },\n      \"required\": [\n        \"agg_by_invoiceHold\",\n        \"agg_by_draftStatusCode\",\n        \"agg_by_dueDate\",\n        \"agg_by_onlineReportId\"\n      ],\n      \"additionalProperties\": false\n    },\n    \"totalResults\": {\n      \"type\": \"string\"\n    },\n    \"max_score\": {\n      \"type\": \"string\"\n    },\n    \"limit\": {\n      \"type\": \"string\"\n    },\n    \"offset\": {\n      \"type\": \"string\"\n    },\n    \"hasMore\": {\n      \"type\": \"string\"\n    },\n    \"items\": {\n      \"type\": \"array\"\n    },\n    \"count\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"took\",\n    \"timed_out\",\n    \"_shards\",\n    \"aggregations\",\n    \"totalResults\",\n    \"max_score\",\n    \"limit\",\n    \"offset\",\n    \"hasMore\",\n    \"items\",\n    \"count\"\n  ],\n  \"additionalProperties\": false\n}"
        },
        {
          "id": "1784702886160",
          "code": "PROCESS_PURCHASE_ORDER_SUMMARY",
          "type": "CODE",
          "metadata": {
            "name": "Process Purchase Order Summary",
            "returnType": "array",
            "sourceCode": "const input = $context.$nodes.FETCH_PURCHASE_ORDER_DATA.$output;\nconst summary = [\n  {\n    name: \"Overdue\",\n    value: input.aggregations.agg_by_dueDate.agg_overdue.count_headers.header_count.value,\n    action: 'ora.invoke(\"fetchPOs\", \"OVERDUE\")'\n  },\n  {\n    name: \"Drafts and Rejected\",\n    value: input.aggregations.agg_by_draftStatusCode.doc_count,\n    action: 'ora.invoke(\"fetchPOs\", \"DRAFTS_AND_REJECTED\")'\n  },\n  {\n    name: \"Invoice Hold\",\n    value: input.aggregations.agg_by_invoiceHold.agg_invoiceHold.count_headers.header_count.value,\n    action: 'ora.invoke(\"fetchPOs\", \"INVOICE_HOLD\")'\n  },\n  {\n    name: \"Processing Errors\",\n    value: input.aggregations.agg_by_onlineReportId.doc_count,\n    action: 'ora.invoke(\"fetchPOs\", \"PROCESSING_ERRORS\")'\n  }\n];\nsummary.sort((a,b) => (b.value ?? 0) - (a.value ?? 0));\nreturn summary;",
            "errorNodeId": "1784702932151",
            "description": "Processes purchase order counts for display."
          },
          "diagram": {
            "x": 6821.40154463664,
            "y": 5871.503829808945
          },
          "outcomes": {
