        {
          "id": "1785400000000",
          "code": "RESOLVE_PURCHASE_ORDER_SELECTION",
          "type": "CODE",
          "metadata": {
            "name": "Resolve Purchase Order Selection",
            "description": "Resolves the selected purchase order view.",
            "errorNodeId": "1784702932151",
            "returnType": "object",
            "sourceCode": "const actionCode = String($context.$app.$OraAction || \"\").trim();\nconst selectionNames = {\n  OVERDUE: \"Overdue\",\n  DRAFTS_AND_REJECTED: \"Drafts and Rejected\",\n  INVOICE_HOLD: \"Invoice Hold\",\n  PROCESSING_ERRORS: \"Processing Errors\"\n};\nconst name = selectionNames[actionCode];\n\nif (!name) {\n  throw new Error(\"Unsupported purchase order action.\");\n}\n\nreturn { name: name };"
          },
          "diagram": {
            "x": 5665.078326145464,
            "y": 5650
