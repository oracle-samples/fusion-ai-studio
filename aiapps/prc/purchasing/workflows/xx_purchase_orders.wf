          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-07/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"items\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"OrderNumber\": {\n            \"type\": \"string\"\n          },\n          \"Status\": {\n            \"type\": \"string\"\n          },\n          \"OrderDescription\": {\n            \"type\": \"string\"\n          },\n          \"Supplier\": {\n            \"type\": \"string\"\n          },\n          \"SupplierId\": {\n            \"type\": \"string\"\n          },\n          \"SupplierSiteId\": {\n            \"type\": \"string\"\n          },\n          \"SupplierSiteContactId\": {\n            \"type\": \"string\"\n          },\n          \"Total\": {\n            \"type\": \"string\"\n          },\n          \"Buyer\": {\n            \"type\": \"string\"\n          },\n          \"BuyerId\": {\n            \"type\": \"string\"\n          },\n          \"Requester\": {\n            \"type\": \"string\"\n          },\n          \"RequesterId\": {\n            \"type\": \"string\"\n          },\n          \"DueDate\": {\n            \"type\": \"string\"\n          },\n          \"DaysOverdue\": {\n            \"type\": \"string\"\n          },\n          \"StatusCode\": {\n            \"type\": \"string\"\n          },\n          \"Requisition\": {\n            \"type\": \"string\"\n          },\n          \"ProcurementBU\": {\n            \"type\": \"string\"\n          },\n          \"POHeaderId\": {\n            \"type\": \"string\"\n          },\n          \"Currency\": {\n            \"type\": \"string\"\n          },\n          \"CurrencyPrecision\": {\n            \"type\": \"string\"\n          },\n          \"DraftStatus\": {\n            \"type\": \"string\"\n          },\n          \"DraftStatusCode\": {\n            \"type\": \"string\"\n          },\n          \"RequisitioningBU\": {\n            \"type\": \"string\"\n          },\n          \"Invoice\": {\n            \"type\": \"string\"\n          },\n          \"Hold\": {\n            \"type\": \"string\"\n          },\n          \"DocumentStyle\": {\n            \"type\": \"string\"\n          },\n          \"CreationDate\": {\n            \"type\": \"string\"\n          },\n          \"ShipToLocation\": {\n            \"type\": \"string\"\n          },\n          \"ShipToLocationId\": {\n            \"type\": \"string\"\n          },\n          \"SoldToLegalEntity\": {\n            \"type\": \"string\"\n          },\n          \"SupplierSite\": {\n            \"type\": \"string\"\n          },\n          \"ProjectNumber\": {\n            \"type\": \"string\"\n          },\n          \"TaskNumber\": {\n            \"type\": \"string\"\n          },\n          \"HasAttachments\": {\n            \"type\": \"string\"\n          },\n          \"ContractTermsExists\": {\n            \"type\": \"string\"\n          },\n          \"RequisitionHeaderId\": {\n            \"type\": \"string\"\n          },\n          \"OnlineReportId\": {\n            \"type\": \"string\"\n          },\n          \"IconType\": {\n            \"type\": \"string\"\n          },\n          \"FrozenFlag\": {\n            \"type\": \"string\"\n          },\n          \"CONum\": {\n            \"type\": \"string\"\n          },\n          \"Revision\": {\n            \"type\": \"string\"\n          },\n          \"ChangeOrderStatus\": {\n            \"type\": \"string\"\n          },\n          \"ChangeOrderStatusCode\": {\n            \"type\": \"string\"\n          },\n          \"BillToLocation\": {\n            \"type\": \"string\"\n          },\n          \"BillToLocationId\": {\n            \"type\": \"string\"\n          },\n          \"SourceAgreement\": {\n            \"type\": \"string\"\n          },\n          \"SpecialHandlingType\": {\n            \"type\": \"string\"\n          },\n          \"ClosedDate\": {\n            \"type\": \"string\"\n          },\n          \"OrderDate\": {\n            \"type\": \"string\"\n          },\n          \"ReferenceNumber\": {\n            \"type\": \"string\"\n          },\n          \"ContractNumber\": {\n            \"type\": \"string\"\n          },\n          \"ContractId\": {\n            \"type\": \"string\"\n          },\n          \"MasterContract\": {\n            \"type\": \"string\"\n          },\n          \"FundsStatus\": {\n            \"type\": \"string\"\n          },\n          \"FundsStatusCode\": {\n            \"type\": \"string\"\n          },\n          \"ChangeOrderFundsStatus\": {\n            \"type\": \"string\"\n          },\n          \"ChangeOrderFundsStatusCode\": {\n            \"type\": \"string\"\n          },\n          \"PendingChangeOrderVersionId\": {\n            \"type\": \"string\"\n          },\n          \"NoteToSupplier\": {\n            \"type\": \"string\"\n          },\n          \"NoteToReceiver\": {\n            \"type\": \"string\"\n          },\n          \"ShipToOrganization\": {\n            \"type\": \"string\"\n          },\n          \"AcceptanceRequiredFlag\": {\n            \"type\": \"string\"\n          },\n          \"PendingResponseRoleCode\": {\n            \"type\": \"string\"\n          },\n          \"RevisionDate\": {\n            \"type\": \"string\"\n          },\n          \"SupplierContact\": {\n            \"type\": \"string\"\n          },\n          \"Credit\": {\n            \"type\": \"string\"\n          },\n          \"Discount\": {\n            \"type\": \"string\"\n          },\n          \"SupplierOrder\": {\n            \"type\": \"string\"\n          },\n          \"ChangeOrderDate\": {\n            \"type\": \"string\"\n          },\n          \"AcceptanceDueDate\": {\n            \"type\": \"string\"\n          },\n          \"ConfirmingOrder\": {\n            \"type\": \"string\"\n          },\n          \"ShippingMethod\": {\n            \"type\": \"string\"\n          },\n          \"DraftOrderCancellationFlag\": {\n            \"type\": \"string\"\n          },\n          \"HeaderAttachmentExistsFlag\": {\n            \"type\": \"string\"\n          },\n          \"CancelDocFlag\": {\n            \"type\": \"string\"\n          },\n          \"ContractTemplateName\": {\n            \"type\": \"string\"\n          },\n          \"SourceAgreementHeaderId\": {\n            \"type\": \"string\"\n          },\n          \"ShipToParty\": {\n            \"type\": \"string\"\n          },\n          \"ShipToCustomerId\": {\n            \"type\": \"string\"\n          },\n          \"ShipToCustomerLocationId\": {\n            \"type\": \"string\"\n          },\n          \"HeaderDFF.PO_HEADERS_BI_Header_Context._DFF_Context\": {\n            \"type\": \"string\"\n          },\n          \"HeaderDFF.testTextDFF\": {\n            \"type\": \"string\"\n          },\n          \"HeaderDFF.abpRegionValue\": {\n            \"type\": \"string\"\n          },\n          \"HeaderDFF.testNumber\": {\n            \"type\": \"string\"\n          },\n          \"HeaderDFF.testText\": {\n            \"type\": \"string\"\n          },\n          \"HeaderDFF.PO_HEADERS_CDRM_PO_HEADERS_DFF._Contact__Name\": {\n            \"type\": \"string\"\n          },\n          \"SupplierSiteHoldFlag\": {\n            \"type\": \"string\"\n          },\n          \"ChangeOrderAcceptanceDueDate\": {\n            \"type\": \"string\"\n          },\n          \"DraftVersionCreationDate\": {\n            \"type\": \"string\"\n          },\n          \"ChangeOrderOriginatorRoleCode\": {\n            \"type\": \"string\"\n          },\n          \"ModeOfTransport\": {\n            \"type\": \"string\"\n          },\n          \"ServiceLevel\": {\n            \"type\": \"string\"\n          },\n          \"HeaderSupplierAttachmentExistsFlag\": {\n            \"type\": \"string\"\n          },\n          \"DaysInDraft\": {\n            \"type\": \"string\"\n          }\n        },\n        \"required\": [\n          \"OrderNumber\",\n          \"Status\",\n          \"OrderDescription\",\n          \"Supplier\",\n          \"SupplierId\",\n          \"SupplierSiteId\",\n          \"SupplierSiteContactId\",\n          \"Total\",\n          \"Buyer\",\n          \"BuyerId\",\n          \"Requester\",\n          \"RequesterId\",\n          \"DueDate\",\n          \"DaysOverdue\",\n          \"StatusCode\",\n          \"Requisition\",\n          \"ProcurementBU\",\n          \"POHeaderId\",\n          \"Currency\",\n          \"CurrencyPrecision\",\n          \"DraftStatus\",\n          \"DraftStatusCode\",\n          \"RequisitioningBU\",\n          \"Invoice\",\n          \"Hold\",\n          \"DocumentStyle\",\n          \"CreationDate\",\n          \"ShipToLocation\",\n          \"ShipToLocationId\",\n          \"SoldToLegalEntity\",\n          \"SupplierSite\",\n          \"ProjectNumber\",\n          \"TaskNumber\",\n          \"HasAttachments\",\n          \"ContractTermsExists\",\n          \"RequisitionHeaderId\",\n          \"OnlineReportId\",\n          \"IconType\",\n          \"FrozenFlag\",\n          \"CONum\",\n          \"Revision\",\n          \"ChangeOrderStatus\",\n          \"ChangeOrderStatusCode\",\n          \"BillToLocation\",\n          \"BillToLocationId\",\n          \"SourceAgreement\",\n          \"SpecialHandlingType\",\n          \"ClosedDate\",\n          \"OrderDate\",\n          \"ReferenceNumber\",\n          \"ContractNumber\",\n          \"ContractId\",\n          \"MasterContract\",\n          \"FundsStatus\",\n          \"FundsStatusCode\",\n          \"ChangeOrderFundsStatus\",\n          \"ChangeOrderFundsStatusCode\",\n          \"PendingChangeOrderVersionId\",\n          \"NoteToSupplier\",\n          \"NoteToReceiver\",\n          \"ShipToOrganization\",\n          \"AcceptanceRequiredFlag\",\n          \"PendingResponseRoleCode\",\n          \"RevisionDate\",\n          \"SupplierContact\",\n          \"Credit\",\n          \"Discount\",\n          \"SupplierOrder\",\n          \"ChangeOrderDate\",\n          \"AcceptanceDueDate\",\n          \"ConfirmingOrder\",\n          \"ShippingMethod\",\n          \"DraftOrderCancellationFlag\",\n          \"HeaderAttachmentExistsFlag\",\n          \"CancelDocFlag\",\n          \"ContractTemplateName\",\n          \"SourceAgreementHeaderId\",\n          \"ShipToParty\",\n          \"ShipToCustomerId\",\n          \"ShipToCustomerLocationId\",\n          \"HeaderDFF.PO_HEADERS_BI_Header_Context._DFF_Context\",\n          \"HeaderDFF.testTextDFF\",\n          \"HeaderDFF.abpRegionValue\",\n          \"HeaderDFF.testNumber\",\n          \"HeaderDFF.testText\",\n          \"HeaderDFF.PO_HEADERS_CDRM_PO_HEADERS_DFF._Contact__Name\",\n          \"SupplierSiteHoldFlag\",\n          \"ChangeOrderAcceptanceDueDate\",\n          \"DraftVersionCreationDate\",\n          \"ChangeOrderOriginatorRoleCode\",\n          \"ModeOfTransport\",\n          \"ServiceLevel\",\n          \"HeaderSupplierAttachmentExistsFlag\",\n          \"DaysInDraft\"\n        ],\n        \"additionalProperties\": false\n      }\n    },\n    \"totalResults\": {\n      \"type\": \"string\"\n    },\n    \"count\": {\n      \"type\": \"string\"\n    },\n    \"limit\": {\n      \"type\": \"string\"\n    },\n    \"offset\": {\n      \"type\": \"string\"\n    },\n    \"hasMore\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\n    \"items\",\n    \"totalResults\",\n    \"count\",\n    \"limit\",\n    \"offset\",\n    \"hasMore\"\n  ],\n  \"additionalProperties\": false\n}"
        },
        {
          "id": "1784711031247",
          "code": "PROCESS_PURCHASE_ORDERS",
          "type": "CODE",
          "metadata": {
            "name": "Process Purchase Orders",
            "returnType": "object",
            "sourceCode": "const selectionName = $context.$nodes.RESOLVE_PURCHASE_ORDER_SELECTION.$output.result.name;\nconst purchaseOrderItems = {\n  Overdue: $context.$nodes.FETCH_OVERDUE_PURCHASE_ORDERS?.$output?.items,\n  \"Drafts and Rejected\": $context.$nodes.FETCH_DRAFT_AND_REJECTED_PURCHASE_ORDERS?.$output?.items,\n  \"Invoice Hold\": $context.$nodes.FETCH_INVOICE_HOLD_PURCHASE_ORDERS?.$output?.items,\n  \"Processing Errors\": $context.$nodes.FETCH_PROCESSING_ERROR_PURCHASE_ORDERS?.$output?.items\n};\nconst input = purchaseOrderItems[selectionName] || [];\n\nconst formatAmount = (amount, currency) => {\n  if (amount == null || String(amount).trim() === \"\") {\n    return \"\";\n  }\n\n  const numericAmount = Number(String(amount).replace(/,/g, \"\").trim());\n\n  if (!Number.isFinite(numericAmount)) {\n    return \"\";\n  }\n\n  const formattedAmount = numericAmount\n    .toFixed(2)\n    .replace(/\\B(?=(\\d{3})+(?!\\d))/g, \",\");\n\n  return currency == null || String(currency).trim() === \"\"\n    ? formattedAmount\n    : `${formattedAmount} ${currency}`;\n};\n\nconst rows = input.map(item => ({\n  \"Order\": item.OrderNumber,\n  \"Order Status\": item.Status,\n  \"StatusCode\": item.StatusCode,\n  \"Requisitioning BU\": item.RequisitioningBU,\n  \"Procurement BU\": item.ProcurementBU,\n  \"Total\": formatAmount(item.Total, item.Currency),\n  \"Buyer\": item.Buyer,\n  \"Supplier\": item.Supplier,\n  \"Requester\": item.Requester,\n  \"Ship-to Location\": item.ShipToLocation,\n  \"Bill-to Location\": item.BillToLocation\n}));\n\nreturn rows;",
            "errorNodeId": "1784702932151",
            "description": "Processes purchase order details for display."
          },
          "diagram": {
            "x": 5675,
            "y": 6316
          },
          "outcomes": {
            "success": "1785308129244"
          },
          "inputs": [],
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
        {
