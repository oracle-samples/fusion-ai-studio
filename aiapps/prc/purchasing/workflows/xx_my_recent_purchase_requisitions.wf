        {
          "id": "1784635975871",
          "code": "FETCH_RECENT_PURCHASE_REQUISITIONS",
          "type": "BO_FUNCTION",
          "metadata": {
            "description": "Retrieves the signed-in user's most recent purchase requisitions and their current statuses.",
            "name": "Fetch Recent Purchase Requisitions",
            "errorNodeId": "1784636682107",
            "businessObjectCode": "ORA_PRC_PURCHASING_XX_MYREQUISITIONS",
            "functionName": "fetchRecentPurchaseRequisitions"
          },
          "diagram": {
            "x": 4456,
            "y": 5405
          },
          "outcomes": {
            "success": "1784636085862"
          },
          "inputs": []
        },
        {
          "id": "1784636085862",
          "code": "PROCESS_REQUISITIONS",
          "type": "CODE",
          "metadata": {
            "name": "Process Requisitions",
            "returnType": "object",
            "sourceCode": "function getRecentRequisitionCardData(response, translations) {\n  const items = Array.isArray(response) ? response : response.items || [];\n\n  function formatDate(value) {\n  if (value == null || value === '') {\n    return null;\n    }\n\n  const date = new Date(value);\n  const day = String(date.getDate()).padStart(2, '0');\n  const month = String(date.getMonth() + 1).padStart(2, '0');\n  const year = date.getFullYear();\n\n  return day + '/' + month + '/' + year;\n  }\n\n  function getLifecycleStatus(item) {\n    return item.DocumentStatusCode === 'APPROVED' &&\n      (\n        item.HasPendingApprovalLinesFlag ||\n        item.HasRejectedLinesFlag ||\n        item.HasReturnedLinesFlag ||\n        item.HasWithdrawnLinesFlag\n      )\n        ? 'MULTIPLE'\n        : item.LifecycleStatusCode;\n  }\n\n  function getBadgeText(item) {\n    const lifecycleStatus = getLifecycleStatus(item);\n\n    if (item.DocumentStatusCode === 'REJECTED' && item.RejectedById === -1) {\n      return translations.AutorejectedBadgeLabel;\n    }\n\n    if (item.DocumentStatusCode === 'APPROVED') {\n      if (lifecycleStatus === 'MULTIPLE') {\n        return translations.SeelinedetailsBadgeLabel;\n      }\n\n      if (lifecycleStatus === 'ORDER_CANCELED') {\n        return translations.OrderCanceled;\n      }\n\n      if ([\n        'ORDER_ON_HOLD',\n        'SHIPPED_ORDER_ON_HOLD',\n        'IN_RECEIVING_ORDER_ON_HOLD',\n        'DELIVERED_ORDER_ON_HOLD',\n        'BILLED_ORDER_ON_HOLD'\n      ].includes(lifecycleStatus)) {\n        return translations.OrderonholdBadgeLabel;\n      }\n\n      return lifecycleStatus != null ? (item.LifecycleStatus || item.DocumentStatus || '') : item.DocumentStatus || '';\n    }\n\n    if (item.DocumentStatusCode === 'INCOMPLETE') {\n      return translations.DraftBadgeLabel;\n    }\n\n    if (item.DocumentStatusCode === 'RETURNED') {\n      return translations.ReturnedbybuyerBadgeLabel;\n    }\n\n    return item.DocumentStatus || '';\n  }\n\n  function getBadgeStatus(item) {\n    const lifecycleStatus = getLifecycleStatus(item);\n\n    switch (item.DocumentStatusCode) {\n      case 'INCOMPLETE':\n      case 'PENDING APPROVAL':\n      case 'WITHDRAWN':\n        return 'warning';\n\n      case 'REJECTED':\n      case 'CANCELED':\n      case 'RETURNED':\n      case 'REPLACED':\n      case 'SPLIT':\n        return 'danger';\n\n      case 'APPROVED':\n        if (lifecycleStatus === 'MULTIPLE') return 'default';\n\n        if ([\n          'ORDER_ON_HOLD',\n          'SHIPPED_ORDER_ON_HOLD',\n          'IN_RECEIVING_ORDER_ON_HOLD',\n          'DELIVERED_ORDER_ON_HOLD',\n          'BILLED_ORDER_ON_HOLD'\n        ].includes(lifecycleStatus)) {\n          return 'warning';\n        }\n\n        if ([\n          'ORDER_CANCELED',\n          'ORDER_CANCELED_REINSTATED',\n          'TRANSFER_CANCELED'\n        ].includes(lifecycleStatus)) {\n          return 'danger';\n        }\n\n        return 'success';\n\n      default:\n        return 'default';\n    }\n  }\n\n  function getFooter(item) {\n    function dateFooter(label, value) {\n      const formatted = formatDate(value);\n      return formatted ? label + ': ' + formatted : null;\n    }\n\n    switch (item.DocumentStatusCode) {\n      case 'INCOMPLETE':\n        return dateFooter('Creation Date', item.CreationDate);\n\n      case 'PENDING APPROVAL':\n        return dateFooter('Submission Date', item.SubmissionDate) ||\n          dateFooter('Creation Date', item.CreationDate);\n\n      case 'APPROVED':\n        return dateFooter('Approved Date', item.ApprovedDate) ||\n          dateFooter('Submission Date', item.SubmissionDate) ||\n          dateFooter('Creation Date', item.CreationDate);\n\n      case 'REJECTED':\n        return item.RejectedByDisplayName\n          ? 'Rejected By: ' + item.RejectedByDisplayName\n          : dateFooter('Last Updated', item.LastUpdateDate);\n\n      case 'RETURNED':\n      case 'WITHDRAWN':\n      case 'CANCELED':\n      case 'REPLACED':\n      case 'SPLIT':\n        return dateFooter('Last Updated', item.LastUpdateDate) ||\n          dateFooter('Creation Date', item.CreationDate);\n\n      default:\n        return dateFooter('Creation Date', item.CreationDate) ||\n          dateFooter('Last Updated', item.LastUpdateDate);\n    }\n  }\n\n  function getSecondaryText(item) {\n    const count = item.lines && item.lines.count != null\n      ? Number(item.lines.count)\n      : null;\n\n    if (count == null || Number.isNaN(count) || count === 0) {\n      return null;\n    }\n\n    return count === 1 ? '1 Line' : count + ' Lines';\n  }\n\n  return items.map(function (item) {\n    return {\n      primaryText: item.Description || null,\n      overlineText: item.Requisition ? 'Requisition ' + item.Requisition : null,\n      secondaryText: getSecondaryText(item),\n      badgeText: getBadgeText(item),\n      badgeStatus: getBadgeStatus(item),\n      footer: getFooter(item)\n    };\n  });\n}\n\nfunction getPriority(item) {\n  const status = item.DocumentStatusCode;\n  const onHoldStatuses = [\n    'ORDER_ON_HOLD',\n    'SHIPPED_ORDER_ON_HOLD',\n    'IN_RECEIVING_ORDER_ON_HOLD',\n    'DELIVERED_ORDER_ON_HOLD',\n    'BILLED_ORDER_ON_HOLD'\n  ];\n\n  if (status === 'REJECTED') return 1;\n  if (status === 'INCOMPLETE') return 2;\n\n  if (['RETURNED', 'CANCELED', 'REPLACED', 'SPLIT'].includes(status)) {\n    return 3;\n  }\n\n  if (\n    ['PENDING APPROVAL', 'WITHDRAWN'].includes(status) ||\n    (status === 'APPROVED' && onHoldStatuses.includes(item.LifecycleStatusCode))\n  ) {\n    return 4;\n  }\n\n  return 5;\n}\n\nconst translations = {\n  AutorejectedBadgeLabel: 'Auto rejected',\n  SeelinedetailsBadgeLabel: 'See line details',\n  OrderCanceled: 'Order Canceled',\n  OrderonholdBadgeLabel: 'Order on hold',\n  DraftBadgeLabel: 'Draft',\n  ReturnedbybuyerBadgeLabel: 'Returned by buyer'\n};\nconst input = $context.$nodes.FETCH_RECENT_PURCHASE_REQUISITIONS.$output.items; \n\nconst slicedInput = input\n  .map(function (item, index) {\n    return { item: item, index: index };\n  })\n  .sort(function (a, b) {\n    return getPriority(a.item) - getPriority(b.item) || a.index - b.index;\n  })\n  .slice(0, 5)\n  .map(function (entry) {\n    return entry.item;\n  });\n\n\nlet output = getRecentRequisitionCardData(slicedInput, translations);\n\nreturn output;",
            "errorNodeId": "1784636682107",
            "description": "Processes recent requisitions for display."
          },
          "diagram": {
            "x": 4489.498658240997,
            "y": 5593.711803150971
